+#define SITL_ERPM_PER_LSB 100.0f
+static float sitlErpmToHz;
+
+void initDshotTelemetry(const timeUs_t looptimeUs)
+{
+    UNUSED(looptimeUs);
+    sitlErpmToHz = SITL_ERPM_PER_LSB / SECONDS_PER_MINUTE / (motorConfig()->motorPoleCount / 2.0f);
