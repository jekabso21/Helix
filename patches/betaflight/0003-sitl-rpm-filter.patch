+// drivers/dshot.c provides these only with USE_DSHOT; the RPM filter only needs these two
+bool useDshotTelemetry = true;
+
+float getMotorFrequencyHz(uint8_t motorIndex)
+{
+    return motorIndex < 4 ? sitlMotorFrequencyHz[motorIndex] : 0.0f;
+}
+
+float getMinMotorFrequencyHz(void)
+{
+    float minimum = sitlMotorFrequencyHz[0];
+    for (int i = 1; i < 4; i++) {
+        if (sitlMotorFrequencyHz[i] < minimum) {
+            minimum = sitlMotorFrequencyHz[i];
+        }
+    }
+    return minimum;
+}
+
+void updateDshotTelemetry(void)
+{
+    // The values arrive over UDP instead of being decoded from a DShot frame. The real driver
+    // fills this debug channel from the decoder, so the simulator fills it from the packet.
+    for (int i = 0; i < 4; i++) {
+        DEBUG_SET(DEBUG_DSHOT_RPM_TELEMETRY, i, (int16_t)lrintf(getDshotRpm(i)));
+    }
+}
+
+// The rest of the DShot telemetry API, which the OSD, MSP and blackbox read
+dshotTelemetryCycleCounters_t dshotDMAHandlerCycleCounters;
+dshotTelemetryState_t dshotTelemetryState;
+
+uint16_t getDshotErpm(uint8_t motorIndex)
+{
+    // eRPM, as a real ESC reports it: mechanical Hz x 60 x pole pairs
+    return (uint16_t)(getMotorFrequencyHz(motorIndex) * SECONDS_PER_MINUTE
+                      * (motorConfig()->motorPoleCount / 2.0f));
+}
+
+float getDshotRpm(uint8_t motorIndex)
+{
+    return getMotorFrequencyHz(motorIndex) * SECONDS_PER_MINUTE;
+}
+
+float getDshotRpmAverage(void)
+{
+    float total = 0.0f;
+    for (int i = 0; i < 4; i++) {
+        total += sitlMotorFrequencyHz[i];
+    }
+    return total / 4.0f * SECONDS_PER_MINUTE;
+}
+
+bool isDshotTelemetryActive(void)
+{
+    return true;
+}
