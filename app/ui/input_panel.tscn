[node name="SaveRow" type="HBoxContainer" parent="Pad/InputPanel/Mapping"]
visible = false
layout_mode = 2
theme_type_variation = &"Gap6"

[node name="Name" type="LineEdit" parent="Pad/InputPanel/Mapping/SaveRow"]
layout_mode = 2
size_flags_horizontal = 3
