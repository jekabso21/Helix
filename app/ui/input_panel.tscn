[node name="Default" type="CheckBox" parent="Pad/InputPanel/Mapping/SaveRow"]
layout_mode = 2
button_pressed = true
text = "default"

[node name="Save" type="Button" parent="Pad/InputPanel/Mapping/SaveRow"]
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "Save"

[node name="Wizard" type="PanelContainer" parent="Pad/InputPanel/Mapping"]
