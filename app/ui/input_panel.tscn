[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/input_panel.gd" id="1"]

[node name="Input" type="ScrollContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Pad" type="MarginContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Pad"

[node name="InputPanel" type="VBoxContainer" parent="Pad"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Sections"
script = ExtResource("1")

[node name="Device" type="VBoxContainer" parent="Pad/InputPanel"]
layout_mode = 2
theme_type_variation = &"Section"

[node name="Title" type="Label" parent="Pad/InputPanel/Device"]
layout_mode = 2
theme_type_variation = &"Kicker"
text = "DEVICE"

[node name="Row" type="HBoxContainer" parent="Pad/InputPanel/Device"]
layout_mode = 2
theme_type_variation = &"Gap6"

[node name="Device" type="OptionButton" parent="Pad/InputPanel/Device/Row"]
fit_to_longest_item = false
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Pick a device to use it"
clip_text = true

[node name="Refresh" type="Button" parent="Pad/InputPanel/Device/Row"]
layout_mode = 2
text = "Refresh"

[node name="Status" type="Label" parent="Pad/InputPanel/Device"]
layout_mode = 2
theme_type_variation = &"Hint"
autowrap_mode = 3
text = "No device detected"

[node name="ProfileRow" type="HBoxContainer" parent="Pad/InputPanel/Device"]
layout_mode = 2
theme_type_variation = &"Gap8"

[node name="Label" type="Label" parent="Pad/InputPanel/Device/ProfileRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Muted"
text = "Mapping profile"

[node name="Profile" type="OptionButton" parent="Pad/InputPanel/Device/ProfileRow"]
fit_to_longest_item = false
custom_minimum_size = Vector2(150, 28)
layout_mode = 2
tooltip_text = "Load a saved mapping into the running session"
theme_type_variation = &"SmallOption"
clip_text = true

[node name="Channels" type="VBoxContainer" parent="Pad/InputPanel"]
layout_mode = 2
theme_type_variation = &"Section"

[node name="Head" type="HBoxContainer" parent="Pad/InputPanel/Channels"]
layout_mode = 2

[node name="Title" type="Label" parent="Pad/InputPanel/Channels/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Kicker"
text = "CHANNELS → BETAFLIGHT"

[node name="Rate" type="Label" parent="Pad/InputPanel/Channels/Head"]
layout_mode = 2
theme_type_variation = &"MonoMuted"

[node name="Rows" type="VBoxContainer" parent="Pad/InputPanel/Channels"]
layout_mode = 2
theme_type_variation = &"Tight"

[node name="AuxToggle" type="Button" parent="Pad/InputPanel/Channels"]
layout_mode = 2
size_flags_horizontal = 0
focus_mode = 0
theme_type_variation = &"GhostButton"
text = "▸ AUX3–8"

[node name="Aux" type="GridContainer" parent="Pad/InputPanel/Channels"]
visible = false
layout_mode = 2
theme_type_variation = &"Grid3"
columns = 3

[node name="Raw" type="VBoxContainer" parent="Pad/InputPanel"]
layout_mode = 2
theme_type_variation = &"Section"

[node name="Head" type="HBoxContainer" parent="Pad/InputPanel/Raw"]
layout_mode = 2

[node name="Title" type="Label" parent="Pad/InputPanel/Raw/Head"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Kicker"
text = "RAW DEVICE"

[node name="Buttons" type="Label" parent="Pad/InputPanel/Raw/Head"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "buttons: —"

[node name="Axes" type="GridContainer" parent="Pad/InputPanel/Raw"]
layout_mode = 2
theme_type_variation = &"Grid4"
columns = 4

[node name="Mapping" type="VBoxContainer" parent="Pad/InputPanel"]
layout_mode = 2
theme_type_variation = &"Section"

[node name="Title" type="Label" parent="Pad/InputPanel/Mapping"]
layout_mode = 2
theme_type_variation = &"Kicker"
text = "MAPPING"

[node name="Help" type="Label" parent="Pad/InputPanel/Mapping"]
layout_mode = 2
theme_type_variation = &"Muted"
autowrap_mode = 3
text = "Press Bind, then move the control in its positive direction. Changes apply live."

[node name="Table" type="VBoxContainer" parent="Pad/InputPanel/Mapping"]
layout_mode = 2
theme_type_variation = &"Stack"

[node name="Rule" type="HSeparator" parent="Pad/InputPanel/Mapping/Table"]
layout_mode = 2

[node name="Actions" type="HBoxContainer" parent="Pad/InputPanel/Mapping"]
layout_mode = 2
theme_type_variation = &"Gap6"
