[node name="Raw" type="VBoxContainer" parent="InputPanel"]
layout_mode = 2

[node name="MappingTitle" type="Label" parent="InputPanel"]
layout_mode = 2
text = "Mapping (changes apply live)"

[node name="Mapping" type="GridContainer" parent="InputPanel"]
layout_mode = 2
