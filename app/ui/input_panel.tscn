[node name="SaveAs" type="Button" parent="Pad/InputPanel/Mapping/Actions"]
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "Save as profile…"

[node name="SetDefault" type="Button" parent="Pad/InputPanel/Mapping/Actions"]
layout_mode = 2
