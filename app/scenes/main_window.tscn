[node name="MainWindow" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2

[node name="Toolbar" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
script = ExtResource("3")

[node name="Session" type="OptionButton" parent="Margin/Layout/Toolbar"]
